# Server
PORT=8787

# --- AI Providers ---
# Leave both keys empty to run in fully local/offline mode:
#   - embeddings.js falls back to a deterministic hashing-vectorizer
#   - llm.js falls back to an extractive answer composed from top chunks
#
# Option A: OpenAI (requires billing/a card)
OPENAI_API_KEY=

# Option B: Groq — free, no credit card required (https://console.groq.com)
# OpenAI-compatible API, so it's a drop-in swap for the LLM answer step.
# (Embeddings still use the local hashing vectorizer — Groq doesn't serve
# embedding models — only the answer-generation step upgrades.)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Models (only used when OPENAI_API_KEY is set)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Chunking
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# Retrieval
TOP_K=4
